{
  "info": {
    "name": "MallHub",
    "description": "MallHub API — Shopping center management platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Registration endpoints (buyer and shop flows).",
      "item": [
        {
          "name": "Register Buyer",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register/buyer",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "buyer"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Buyer - Duplicate Email",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register/buyer",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "buyer"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Buyer - Validation Errors",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register/buyer",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "buyer"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid\",\n  \"password\": \"short\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Shop",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register/shop",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "shop"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"jane.smith@example.com\",\n  \"password\": \"password123\",\n  \"shopName\": \"La Boutique de Jane\",\n  \"shopDescription\": \"Une boutique de vêtements tendance\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Shop - Duplicate Shop Name",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register/shop",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "shop"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Martin\",\n  \"email\": \"alice.martin@example.com\",\n  \"password\": \"password123\",\n  \"shopName\": \"La Boutique de Jane\",\n  \"shopDescription\": \"Tentative de doublon\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Shop - Validation Errors",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register/shop",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "shop"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Martin\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
  ]
}
