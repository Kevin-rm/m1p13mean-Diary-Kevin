{
  "companyAnnouncements": [
    "📘 Refer to the project documentation for usage details.",
    "📄 Review guidelines before proceeding.",
    "🧠 Keep modifications minimal and focused.",
    "⚠️ Ensure adjustments align with project requirements.",
    "🔍 Please review generated changes carefully before applying them."
  ],
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm prettier:*)",
      "Bash(pnpm eslint:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)",

      "Bash(sudo:*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable"
  },
  "showTurnDuration": true
}
